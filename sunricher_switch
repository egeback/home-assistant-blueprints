blueprint:
  name: Sunricher SR-ZGP2801K2-DIM Switch Automation
  description: >
    Support for Sunricher SR-ZGP2801K2-DIM Zigbee dimmer switch buttons.
    Configure actions for each button press type (on, off, move_up_with_on_off, move_down_with_on_off, level_control_stop)
  domain: automation
  input:
    sunricher-switch-button1:
      name: "Sunricher Switch button"
      description: "Switch button"
      selector:
        entity:
          # domain_class: button
          # event: {}
          multiple: true

    button_on:
      name: Short Release 1
      description: Action to run on button upper-left short release
      default: []
      selector:
        action: {}
    button_off:
      name: Short Release 2
      description: Action to run on button lower-left short release
      default: []
      selector:
        action: {}
        
    button_on_repeat:
      name: Long Release 1
      description: Action to run on button upper-left long release
      default: []
      selector:
        action: {}
    button_off_repeat:
      name: Long Release 2
      description: Action to run on button lower-left long release
      default: []
      selector:
        action: {}

mode: queued
max: 10

trigger:
- platform: state
  entity_id: !input 'sunricher-switch-button1'
  id: button

actions:
  - variables:
      switch_to_state: "{{ trigger.to_state.attributes.event_type }}"
      switch_from_state: "{{ trigger.from_state.attributes.event_type }}"
  - choose:
      - conditions: "{{ switch_to_state == 'on' }}"
        sequence: !input 'button_on'
      - conditions: "{{ switch_to_state == 'off' }}"
        sequence:
          - repeat:
              until: "{{ repeat.index > 60 }}"
              sequence:
                - !input 'button_off_repeat'
                - delay: "00:00:00.10"
      - conditions: "{{ switch_to_state == 'move_up_with_on_off' }}"
        sequence:
          - repeat:
              until: "{{ repeat.index > 60 }}"
              sequence:
                !input 'button_on_repeat'
                - delay: "00:00:00.10"
      - conditions: "{{ switch_to_state == 'move_down_with_on_off' }}"
        sequence:
          - repeat:
              until: "{{ repeat.index > 60 }}"
              sequence:
                !input 'button_on_repeat'
                - delay: "00:00:00.10"
      - conditions: "{{ switch_to_state == 'level_control_stop' }}"
        sequence:
          - choose:
              - conditions: "{{ switch_from_state == 'move_up_with_on_off' }}"
                sequence: null
              - conditions: "{{ switch_from_state == 'move_down_with_on_off' }}"
                sequence: null