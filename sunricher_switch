blueprint:
  name: Four Button Push Controller (press/hold) - Event Trigger
  description: >
    Handles 4-button push devices reporting presses/releases via events.
    Supports click and hold loops (for dimming or repeated actions).
  domain: automation

  input:
    action_event:
      name: Event
      description: Event entity reporting button presses in `event_type`
      selector:
        entity:
          domain: event
          multiple: false

    # Click actions
    button1_click:
      name: Button 1 Click
      default: []
      selector: {action: {}}
    button2_click:
      name: Button 2 Click
      default: []
      selector: {action: {}}
    button3_click:
      name: Button 3 Click
      default: []
      selector: {action: {}}
    button4_click:
      name: Button 4 Click
      default: []
      selector: {action: {}}

    # Hold actions
    button1_hold:
      name: Button 1 Hold Loop
      default: []
      selector: {action: {}}
    button2_hold:
      name: Button 2 Hold Loop
      default: []
      selector: {action: {}}
    button3_hold:
      name: Button 3 Hold Loop
      default: []
      selector: {action: {}}
    button4_hold:
      name: Button 4 Hold Loop
      default: []
      selector: {action: {}}

mode: restart

trigger:
  - platform: event
    event_type: !input action_event

variables:
  ae: !input action_event
  new_state: "{{ trigger.event.data.event_type }}"
  old_state: "{{ trigger.event.data.old_event_type | default('') }}"

action:
  choose:

    # ------------ BUTTON 1 ------------
    - conditions: "{{ old_state != 'press_1' and new_state == 'press_1' }}"
      sequence:
        - repeat:
            while: "{{ trigger.event.data.event_type == 'press_1' }}"
            sequence: !input button1_hold

    - conditions: "{{ old_state != 'release_1' and new_state == 'release_1' }}"
      sequence: !input button1_click

    # ------------ BUTTON 2 ------------
    - conditions: "{{ old_state != 'press_2' and new_state == 'press_2' }}"
      sequence:
        - repeat:
            while: "{{ trigger.event.data.event_type == 'press_2' }}"
            sequence: !input button2_hold

    - conditions: "{{ old_state != 'release_2' and new_state == 'release_2' }}"
      sequence: !input button2_click

    # ------------ BUTTON 3 ------------
    - conditions: "{{ old_state != 'press_3' and new_state == 'press_3' }}"
      sequence:
        - repeat:
            while: "{{ trigger.event.data.event_type == 'press_3' }}"
            sequence: !input button3_hold

    - conditions: "{{ old_state != 'release_3' and new_state == 'release_3' }}"
      sequence: !input button3_click

    # ------------ BUTTON 4 ------------
    - conditions: "{{ old_state != 'press_4' and new_state == 'press_4' }}"
      sequence:
        - repeat:
            while: "{{ trigger.event.data.event_type == 'press_4' }}"
            sequence: !input button4_hold

    - conditions: "{{ old_state != 'release_4' and new_state == 'release_4' }}"
      sequence: !input button4_click
