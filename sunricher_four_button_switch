blueprint:
  name: Four Button Push Controller with Combos (press/hold)
  description: >
    Handles 4-button push devices reporting presses/releases via event entity attributes.
    Supports click, hold loops (for dimming), and multi-button combinations.
  domain: automation

  input:
    action_entity:
      name: Action Entity
      description: Entity reporting button presses in `attributes.event_type`
      selector:
        entity:
          domain: event
          multiple: false

    # Single button click actions
    button1_click:
      name: Button 1 Click
      default: []
      selector: {action: {}}
    button2_click:
      name: Button 2 Click
      default: []
      selector: {action: {}}
    button3_click:
      name: Button 3 Click
      default: []
      selector: {action: {}}
    button4_click:
      name: Button 4 Click
      default: []
      selector: {action: {}}

    # Single button hold actions
    button1_hold:
      name: Button 1 Hold Loop
      default: []
      selector: {action: {}}
    button2_hold:
      name: Button 2 Hold Loop
      default: []
      selector: {action: {}}
    button3_hold:
      name: Button 3 Hold Loop
      default: []
      selector: {action: {}}
    button4_hold:
      name: Button 4 Hold Loop
      default: []
      selector: {action: {}}

    # Multi-button combinations
    button1_3_click:
      name: Button 1+3 Click
      default: []
      selector: {action: {}}
    button2_4_click:
      name: Button 2+4 Click
      default: []
      selector: {action: {}}
    button1_3_hold:
      name: Button 1+3 Hold Loop
      default: []
      selector: {action: {}}
    button2_4_hold:
      name: Button 2+4 Hold Loop
      default: []
      selector: {action: {}}

triggers:
  - triggers:
      - entity_id:
          - !input action_entity
        id: button
        trigger: state

mode: restart

action:
  - variables:
      ae: !input action_entity
      new_state: "{{ trigger.to_state.attributes.event_type }}"
      old_state: "{{ trigger.from_state.attributes.event_type | default('') }}"

  - choose:

      # ------------ BUTTON 1 ------------
      - conditions: "{{ old_state != 'press_1' and new_state == 'press_1' }}"
        sequence:
          - repeat:
              while: "{{ state_attr(ae, 'event_type') == 'press_1' }}"
              sequence: !input button1_hold

      - conditions: "{{ old_state != 'release_1' and new_state == 'release_1' }}"
        sequence: !input button1_click

      # ------------ BUTTON 2 ------------
      - conditions: "{{ old_state != 'press_2' and new_state == 'press_2' }}"
        sequence:
          - repeat:
              while: "{{ state_attr(ae, 'event_type') == 'press_2' }}"
              sequence: !input button2_hold

      - conditions: "{{ old_state != 'release_2' and new_state == 'release_2' }}"
        sequence: !input button2_click

      # ------------ BUTTON 3 ------------
      - conditions: "{{ old_state != 'press_3' and new_state == 'press_3' }}"
        sequence:
          - repeat:
              while: "{{ state_attr(ae, 'event_type') == 'press_3' }}"
              sequence: !input button3_hold

      - conditions: "{{ old_state != 'release_3' and new_state == 'release_3' }}"
        sequence: !input button3_click

      # ------------ BUTTON 4 ------------
      - conditions: "{{ old_state != 'press_4' and new_state == 'press_4' }}"
        sequence:
          - repeat:
              while: "{{ state_attr(ae, 'event_type') == 'press_4' }}"
              sequence: !input button4_hold

      - conditions: "{{ old_state != 'release_4' and new_state == 'release_4' }}"
        sequence: !input button4_click

      # ------------ BUTTON 1+3 COMBO ------------
      - conditions: "{{ old_state != 'press_1_and_3' and new_state == 'press_1_and_3' }}"
        sequence:
          - repeat:
              while: "{{ state_attr(ae, 'event_type') == 'press_1_and_3' }}"
              sequence: !input button1_3_hold

      - conditions: "{{ old_state != 'release_1_and_3' and new_state == 'release_1_and_3' }}"
        sequence: !input button1_3_click

      # ------------ BUTTON 2+4 COMBO ------------
      - conditions: "{{ old_state != 'press_2_and_4' and new_state == 'press_2_and_4' }}"
        sequence:
          - repeat:
              while: "{{ state_attr(ae, 'event_type') == 'press_2_and_4' }}"
              sequence: !input button2_4_hold

      - conditions: "{{ old_state != 'release_2_and_4' and new_state == 'release_2_and_4' }}"
        sequence: !input button2_4_click
