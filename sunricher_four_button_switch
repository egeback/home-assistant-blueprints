blueprint:
  name: "Dual Light 4-Button Dimmer (Tap Off / Hold Dim)"
  description: "B1/B2 control Light A, B3/B4 control Light B. Even buttons: Tap for OFF, Hold to DIM."
  domain: automation
  input:
    remote_event_entity:
      name: Remote Event Entity
      description: Select the event entity (e.g., event.matrum_switch_action).
      selector:
        entity:
          filter:
            - domain: event
    light_a:
      name: Light A (Buttons 1 & 2)
      selector:
        target:
          entity:
            domain: light
    light_b:
      name: Light B (Buttons 3 & 4)
      selector:
        target:
          entity:
            domain: light

mode: restart
max_exceeded: silent

trigger:
  - platform: state
    entity_id: !input remote_event_entity

action:
  - variables:
      action_val: "{{ trigger.to_state.attributes.event_type }}"
      # Duration calculation to distinguish Tap from Hold
      duration: "{{ as_timestamp(now()) - as_timestamp(trigger.from_state.last_changed | default(now())) }}"

  - choose:
      # BUTTON 1: ON / BRIGHTEN LIGHT A
      - conditions: "{{ action_val == 'press_1' }}"
        sequence:
          - action: light.turn_on
            target: !input light_a
          - repeat:
              while: [ { condition: template, value_template: "true" } ]
              sequence:
                - action: light.turn_on
                  data: { brightness_step_pct: 10 }
                  target: !input light_a
                - delay: { milliseconds: 300 }

      # BUTTON 2: DIM LIGHT A (Hold logic)
      - conditions: "{{ action_val == 'press_2' }}"
        sequence:
          - delay: { milliseconds: 300 } # Wait to see if it's a hold
          - repeat:
              while: [ { condition: template, value_template: "true" } ]
              sequence:
                - action: light.turn_on
                  data: { brightness_step_pct: -10 }
                  target: !input light_a
                - delay: { milliseconds: 300 }

      # BUTTON 3: ON / BRIGHTEN LIGHT B
      - conditions: "{{ action_val == 'press_3' }}"
        sequence:
          - action: light.turn_on
            target: !input light_b
          - repeat:
              while: [ { condition: template, value_template: "true" } ]
              sequence:
                - action: light.turn_on
                  data: { brightness_step_pct: 10 }
                  target: !input light_b
                - delay: { milliseconds: 300 }

      # BUTTON 4: DIM LIGHT B (Hold logic)
      - conditions: "{{ action_val == 'press_4' }}"
        sequence:
          - delay: { milliseconds: 300 }
          - repeat:
              while: [ { condition: template, value_template: "true" } ]
              sequence:
                - action: light.turn_on
                  data: { brightness_step_pct: -10 }
                  target: !input light_b
                - delay: { milliseconds: 300 }

      # RELEASE LOGIC: Handle Taps for Off
      - conditions:
          - condition: template
            value_template: "{{ action_val in ['release_1', 'release_2', 'release_3', 'release_4'] }}"
        sequence:
          - choose:
              # If button 2 or 4 was released quickly (under 400ms), turn off
              - conditions: "{{ action_val == 'release_2' and duration < 0.4 }}"
                sequence:
                  - action: light.turn_off
                    target: !input light_a
              - conditions: "{{ action_val == 'release_4' and duration < 0.4 }}"
                sequence:
                  - action: light.turn_off
                    target: !input light_b
          - stop: "Button released"
