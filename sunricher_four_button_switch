blueprint:
  name: Four-Button Push Controller (press/hold)
  description: >
    Trigger actions from a 4-button push device that exposes press_#/release_#
    states on a single 'action' entity. Click = short press, Hold = while pressed.
  domain: automation
  input:
    action_entity:
      name: Action Entity
      description: The entity that exposes press_#/release_# states
      selector:
        entity:
          filter:
            domain: event
          multiple: true

    # Click actions
    button1_click:
      name: Button 1 Click
      default: []
      selector: {action: {}}
    button2_click:
      name: Button 2 Click
      default: []
      selector: {action: {}}
    button3_click:
      name: Button 3 Click
      default: []
      selector: {action: {}}
    button4_click:
      name: Button 4 Click
      default: []
      selector: {action: {}}

    # Hold actions (looping until release)
    button1_hold:
      name: Button 1 Hold Loop
      default: []
      selector: {action: {}}
    button2_hold:
      name: Button 2 Hold Loop
      default: []
      selector: {action: {}}
    button3_hold:
      name: Button 3 Hold Loop
      default: []
      selector: {action: {}}
    button4_hold:
      name: Button 4 Hold Loop
      default: []
      selector: {action: {}}

mode: restart
max_exceeded: silent

trigger:
  - platform: state
    entity_id: !input action_entity

variables:
  new_state: "{{ trigger.to_state.state }}"

action:
  choose:
    # Button 1
    - conditions: "{{ new_state == 'press_1' }}"
      sequence:
        - repeat:
            while: "{{ states(action_entity) == 'press_1' }}"
            sequence: !input button1_hold
    - conditions: "{{ new_state == 'release_1' }}"
      sequence: !input button1_click

    # Button 2
    - conditions: "{{ new_state == 'press_2' }}"
      sequence:
        - repeat:
            while: "{{ states(action_entity) == 'press_2' }}"
            sequence: !input button2_hold
    - conditions: "{{ new_state == 'release_2' }}"
      sequence: !input button2_click

    # Button 3
    - conditions: "{{ new_state == 'press_3' }}"
      sequence:
        - repeat:
            while: "{{ states(action_entity) == 'press_3' }}"
            sequence: !input button3_hold
    - conditions: "{{ new_state == 'release_3' }}"
      sequence: !input button3_click

    # Button 4
    - conditions: "{{ new_state == 'press_4' }}"
      sequence:
        - repeat:
            while: "{{ states(action_entity) == 'press_4' }}"
            sequence: !input button4_hold
    - conditions: "{{ new_state == 'release_4' }}"
      sequence: !input button4_click