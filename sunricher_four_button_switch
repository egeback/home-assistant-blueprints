blueprint:
  name: Four Button Push Controller (press/hold)
  description: >
    Handle 4-button press devices exposing press_#/release_#
    on a single action entity. Supports click and hold.
  domain: automation

  input:
    action_entity:
      name: Action Entity
      description: Entity reporting press_#/release_#
      selector:
        entity:
          multiple: false

    # Click actions
    button1_click:
      name: Button 1 Click
      default: []
      selector: {action: {}}
    button2_click:
      name: Button 2 Click
      default: []
      selector: {action: {}}
    button3_click:
      name: Button 3 Click
      default: []
      selector: {action: {}}
    button4_click:
      name: Button 4 Click
      default: []
      selector: {action: {}}

    # Hold actions
    button1_hold:
      name: Button 1 Hold Loop
      default: []
      selector: {action: {}}
    button2_hold:
      name: Button 2 Hold Loop
      default: []
      selector: {action: {}}
    button3_hold:
      name: Button 3 Hold Loop
      default: []
      selector: {action: {}}
    button4_hold:
      name: Button 4 Hold Loop
      default: []
      selector: {action: {}}

mode: restart

trigger:
  - platform: state
    entity_id: !input action_entity

variables:
  ae: !input action_entity
  new: "{{ trigger.to_state.state }}"

action:
  choose:

    # ---------------- BUTTON 1 ----------------
    - conditions: "{{ new == 'press_1' }}"
      sequence:
        - repeat:
            while: "{{ states(ae) == 'press_1' }}"
            sequence: !input button1_hold
    - conditions: "{{ new == 'release_1' }}"
      sequence: !input button1_click

    # ---------------- BUTTON 2 ----------------
    - conditions: "{{ new == 'press_2' }}"
      sequence:
        - repeat:
            while: "{{ states(ae) == 'press_2' }}"
            sequence: !input button2_hold
    - conditions: "{{ new == 'release_2' }}"
      sequence: !input button2_click

    # ---------------- BUTTON 3 ----------------
    - conditions: "{{ new == 'press_3' }}"
      sequence:
        - repeat:
            while: "{{ states(ae) == 'press_3' }}"
            sequence: !input button3_hold
    - conditions: "{{ new == 'release_3' }}"
      sequence: !input button3_click

    # ---------------- BUTTON 4 ----------------
    - conditions: "{{ new == 'press_4' }}"
      sequence:
        - repeat:
            while: "{{ states(ae) == 'press_4' }}"
            sequence: !input button4_hold
    - conditions: "{{ new == 'release_4' }}"
      sequence: !input button4_click